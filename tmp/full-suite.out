    '    return persistBackendOutbox();\r\n' +
    '  }).catch(() => {});\r\n' +
    '}\r\n' +
    '\r\n' +
    'async function flushBackendOutbox() {\r\n' +
    '  // Keep queued incoming messages until the server has bound this socket to\r\n' +

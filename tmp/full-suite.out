    '      .then((stored) => {\r\n' +
    '        const persisted = Array.isArray(stored?.[BACKEND_OUTBOX_STORAGE_KEY])\r\n' +
    '          ? stored[BACKEND_OUTBOX_STORAGE_KEY]\r\n' +
